{
  "name": "bilyqo-print-agent",
  "version": "0.1.3",
  "private": true,
  "description": "Bilyqo Windows receipt printing companion",
  "author": "Bilyqo",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "npm run build && node scripts/launch.cjs .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test:ui": "npm run build && node scripts/launch.cjs scripts/preview-smoke.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "com.bilyqo.printagent",
    "productName": "Bilyqo Print Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BilyqoPrintAgent-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iamaffanshaikh",
        "repo": "print-agent-bilyqo",
        "releaseType": "release"
      }
    ]
  }
}
